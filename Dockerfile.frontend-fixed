FROM nginx:1.25-alpine
COPY --from=sooryacvatreg.azurecr.io/cvat-ui:latest /usr/share/nginx/html /usr/share/nginx/html
RUN echo 'server { listen 8081; root /usr/share/nginx/html; location / { try_files $uri $uri/ /index.html; } location /assets { expires 1y; } }' > /etc/nginx/conf.d/default.conf
EXPOSE 8081
